{
  "manifest_version": 3,
  "name": "Headerly",
  "version": "1.0.0",
  "description": "Add or replace request headers on URLs you choose.",
  "icons": {
    "16": "assets/icons/headerly-16.png",
    "32": "assets/icons/headerly-32.png",
    "48": "assets/icons/headerly-48.png",
    "128": "assets/icons/headerly-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "Headerly",
    "default_icon": {
      "16": "assets/icons/headerly-16.png",
      "32": "assets/icons/headerly-32.png"
    },
    "default_popup": "src/popup.html"
  }
}
